# This .gitignore is tailored for Unity projects
# See https://github.com/github/gitignore/blob/main/Unity.gitignore for reference

# ==== Unity Generated Files ====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
MemoryCaptures/

# Asset meta data should be ignored when the corresponding asset is also ignored
*.pidb
*.suo
*.user
*.userprefs
*.unityproj
*.booproj
*.svd
*.pdb
*.mdb

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage

# Visual Studio / MonoDevelop generated files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# JetBrains Rider
.idea/
*.sln.iml

# OS generated files
.DS_Store
Thumbs.db

# Python env
\.venv/

# ML-Agents results and model output
results/
*.nn
*.onnx

# Local Unity build output
App/

# WoW cache (historical)

# Generated by Unity package manager
Packages/packages-lock.json

# Ignore settings that may contain local paths
ProjectSettings/EditorUserSettings.asset

# Uncomment if you store Gradle cache
# .gradle/

# Lock files
*.lock

.vscode/settings.json
Packages/manifest.json
ProjectSettings/ProjectVersion.txt
ProjectSettings/Packages/com.unity.testtools.codecoverage/Settings.json

Recordings/
./Assets/Scenes/*
./Assets/Prefab/*
./Assets/Models/*
./Assets/ML-Agents/*
